---
import Base from '../layouts/Base.astro';
---
<Base lang="en" title="Page not found">
  <section class="section">
    <div class="wrap" style="text-align:center">
      <p class="kicker">404</p>
      <h1>This page has moved</h1>
      <p class="muted">The property may have been sold or the link changed. · ייתכן שהנכס נמכר או שהקישור השתנה.</p>
      <p style="margin-top:28px; display:flex; gap:12px; justify-content:center; flex-wrap:wrap">
        <a class="btn btn-gold" href="/properties/">View properties</a>
        <a class="btn btn-outline" href="/he/properties/">לכל הנכסים</a>
      </p>
    </div>
  </section>
</Base>
