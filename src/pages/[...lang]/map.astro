---
import Base from '../../layouts/Base.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import LogoSkyline from '../../components/LogoSkyline.astro';
import SearchBox from '../../components/SearchBox.astro';
import { t, getLang, langPaths, href, L, active, img, ils, fxDefault } from '../../lib/i18n.js';
export const getStaticPaths = langPaths;
const lang = getLang(Astro.params.lang);
const s = t[lang];
const list = active.filter((p) => p.geo);
const uniq = (arr) => [...new Map(arr.filter((x) => x.en).map((x) => [x.en, x])).values()];
const hoods = uniq(list.map((p) => p.neighborhood)).sort((a, b) => L(a, lang).localeCompare(L(b, lang), lang));
// Short price for map pins: ₪34M / ₪6.45M / ₪8.2K
const short = (p) => {
  if (!p.price) return lang === 'he' ? 'לפי דרישה' : 'On request';
  const v = p.price;
  const n = v >= 1e6 ? `${+(v / 1e6).toFixed(2)}M` : v >= 1e3 ? `${+(v / 1e3).toFixed(1)}K` : `${v}`;
  return `₪${n}`;
};
const pins = list.map((p) => ({
  id: p.id,
  lat: p.geo.lat,
  lng: p.geo.lng,
  label: short(p),
  title: L(p.title, lang),
  hood: L(p.neighborhood, lang),
  price: ils(p, lang),
  url: href(lang, `/properties/${p.slug}/`),
  photo: img(p.cover, 800),
  status: p.status,
}));
---
<Base lang={lang} title={s.nav.map}>
  <section class="search-band search-band-map">
    <img src="/img/sky/day-1688.webp" srcset="/img/sky/day-1280.webp 1280w, /img/sky/day-1688.webp 1688w" sizes="100vw" alt="" />
    <div class="wrap">
      <h1>{s.nav.map}</h1>
      <SearchBox lang={lang} id="map-filters" />
    </div>
    <LogoSkyline />
  </section>
  <section class="map-page">
    <aside class="map-list">
      <div class="map-list-head">
        <p class="muted count"><span id="map-count">{list.length}</span> {s.results}</p>
      </div>
      <p class="muted empty" id="map-empty" hidden>{s.noResults}</p>
      <div class="map-cards" id="map-cards">
        {list.map((p) => <div class="map-card-wrap" data-id={p.id} data-status={p.status}><PropertyCard p={p} lang={lang} lux={false} /></div>)}
      </div>
    </aside>
    <div class="map-canvas" id="map" aria-label={s.nav.map}></div>
  </section>
  <script type="application/json" id="pins" set:html={JSON.stringify(pins)} />
  <script>
    import { mountMap } from '../../lib/map.js';
    mountMap();
  </script>
</Base>
