---
import Base from '../../layouts/Base.astro';
import Services from '../../components/Services.astro';
import Reviews from '../../components/Reviews.astro';
import { t, getLang, langPaths, L } from '../../lib/i18n.js';
export const getStaticPaths = langPaths;
const lang = getLang(Astro.params.lang);
const s = t[lang];
---
<Base lang={lang} title={s.nav.about}>
  <section class="page-head"><div class="wrap"><h1>{s.nav.about}</h1></div></section>
  <section class="section">
    <div class="wrap about-split">
      <div>
        <p class="kicker">{s.aboutKicker}</p>
        <h2>{s.aboutTitle}</h2>
        <p class="lead-dark">{s.aboutBody}</p>
      </div>
      <Reviews lang={lang} />
    </div>
  </section>

  <Services lang={lang} tint />
</Base>
