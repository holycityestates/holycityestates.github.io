---
// The Sold page was folded into the bottom of Properties; this keeps old links working.
import { getLang, langPaths, href } from '../../lib/i18n.js';
export const getStaticPaths = langPaths;
const to = href(getLang(Astro.params.lang), '/properties/#sold');
---
<!doctype html>
<html><head><meta charset="utf-8" /><meta name="robots" content="noindex" /><meta http-equiv="refresh" content={`0; url=${to}`} /><link rel="canonical" href={to} /></head>
<body><a href={to}>Recently sold &amp; rented</a></body></html>
