---
import Base from '../../layouts/Base.astro';
import ContactHero from '../../components/ContactHero.astro';
import { t, getLang, langPaths, L, site, waLink } from '../../lib/i18n.js';
export const getStaticPaths = langPaths;
const lang = getLang(Astro.params.lang);
const s = t[lang];
---
<Base lang={lang} title={s.contactTitle} transparent>
  <ContactHero lang={lang} />
  <section class="section">
    <div class="wrap contact-split">
      <div>
        <p class="kicker">{s.office}</p>
        <h2 class="contact-office">{L(site.address, lang)}</h2>
        <a class="btn btn-gold" href={waLink('')} target="_blank" rel="noopener">{s.whatsapp}</a>
      </div>
      <iframe
        class="map"
        title="Map"
        loading="lazy"
        src="https://www.google.com/maps?q=King+George+St+26,+Jerusalem&output=embed"></iframe>
    </div>
  </section>
</Base>
